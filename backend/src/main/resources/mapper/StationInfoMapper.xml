<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fuelsync.domain.station.mapper.StationInfoMapper">

    <resultMap id="StationInfoResult" type="com.fuelsync.domain.station.model.StationInfo">
        <id     column="station_id"   property="stationId"/>
        <result column="station_name" property="stationName"/>
        <result column="address"      property="address"/>
        <result column="katech_x"     property="katechX"/>
        <result column="katech_y"     property="katechY"/>
        <result column="phone"        property="phone"/>
        <result column="brand"        property="brand"/>
        <result column="updated_at"   property="updatedAt"/>
    </resultMap>

    <select id="findFirst" resultMap="StationInfoResult">
        SELECT * FROM tb_station_info ORDER BY station_id LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="stationId">
        INSERT INTO tb_station_info (station_name, address, katech_x, katech_y, phone, brand)
        VALUES (#{stationName}, #{address}, #{katechX}, #{katechY}, #{phone}, #{brand})
    </insert>

    <update id="update">
        UPDATE tb_station_info
        SET station_name = #{stationName},
            address      = #{address},
            katech_x     = #{katechX},
            katech_y     = #{katechY},
            phone        = #{phone},
            brand        = #{brand}
        WHERE station_id = #{stationId}
    </update>

</mapper>
